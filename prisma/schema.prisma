generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIPPER
  MODERATOR
}

enum Platform {
  TIKTOK
  YOUTUBE
  INSTAGRAM
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum LedgerType {
  ACCRUAL
  PAYOUT
  ADJUSTMENT
}

model User {
  id             String                @id @default(cuid())
  login          String                @unique
  password       String
  role           Role                  @default(CLIPPER)
  isActive       Boolean               @default(true)
  wallet         String?
  steamTradeUrl  String?
  telegramChatId String?
  accounts       PlatformAccount[]
  submissions    Submission[]
  messages       Message[]
  readStates     SubmissionReadState[]
  ledger         LedgerEntry[]
  weekResults    WeekResult[]
  closedWeeks    WeekClosure[]
  createdAt      DateTime              @default(now())
}

model LoginAttempt {
  login          String    @id
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

model PlatformAccount {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  platform    Platform
  url         String
  status      AccountStatus @default(PENDING)
  submissions Submission[]

  @@unique([platform, url])
}

model Submission {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id])
  accountId    String
  account      PlatformAccount       @relation(fields: [accountId], references: [id])
  videoUrl     String                @unique
  publishedAt  DateTime
  views        Int                   @default(0)
  amountCents  Int                   @default(0)
  weekStart    DateTime
  status       SubmissionStatus      @default(PENDING)
  rejectReason String?
  reviewedAt   DateTime?
  messages     Message[]
  readStates   SubmissionReadState[]
  createdAt    DateTime              @default(now())

  @@index([status, weekStart])
  @@index([userId, weekStart])
}

model Message {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  authorId     String
  author       User       @relation(fields: [authorId], references: [id])
  text         String
  createdAt    DateTime   @default(now())

  @@index([submissionId, createdAt, id])
}

model SubmissionReadState {
  userId       String
  submissionId String
  lastReadAt   DateTime
  user         User       @relation(fields: [userId], references: [id])
  submission   Submission @relation(fields: [submissionId], references: [id])

  @@id([userId, submissionId])
}

model LedgerEntry {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  type         LedgerType
  amountCents  Int
  submissionId String?    @unique
  weekStart    DateTime?
  note         String?
  createdAt    DateTime   @default(now())
}

model WeekClosure {
  id         String   @id @default(cuid())
  weekStart  DateTime @unique
  closedAt   DateTime @default(now())
  closedById String
  closedBy   User     @relation(fields: [closedById], references: [id])
}

model WeekResult {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  weekStart     DateTime
  weekCents     Int
  carryInCents  Int
  payableCents  Int
  carryOutCents Int
  expiredCents  Int
  createdAt     DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([weekStart])
}
