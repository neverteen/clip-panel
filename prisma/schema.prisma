generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIPPER
  MODERATOR
}

enum Platform {
  TIKTOK
  YOUTUBE
  INSTAGRAM
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum LedgerType {
  ACCRUAL
  PAYOUT
  ADJUSTMENT
}

enum PayoutMethod {
  CRYPTO
  SKINS
}

enum PayoutStatus {
  REQUESTED
  PAID
  REJECTED
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum NotificationKind {
  NEW_SUBMISSION
  NEW_ACCOUNT
  NEW_PAYOUT
  CHAT_MESSAGE
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  WEEK_CLOSED
  PAYOUT_PAID
  PAYOUT_REJECTED
  TELEGRAM_LINKED
  TELEGRAM_UNLINKED
}

model User {
  id                           String                @id @default(cuid())
  login                        String                @unique
  password                     String
  role                         Role                  @default(CLIPPER)
  isActive                     Boolean               @default(true)
  wallet                       String?
  steamTradeUrl                String?
  passwordChangedAt            DateTime?
  telegramChatId               String?               @unique
  telegramNotificationsEnabled Boolean               @default(true)
  accounts                     PlatformAccount[]     @relation("PlatformAccountOwner")
  accountsAdded                PlatformAccount[]     @relation("PlatformAccountAddedBy")
  submissions                  Submission[]
  messages                     Message[]
  readStates                   SubmissionReadState[]
  ledger                       LedgerEntry[]
  payouts                      Payout[]              @relation("PayoutOwner")
  processedPayouts             Payout[]              @relation("PayoutProcessor")
  weekResults                  WeekResult[]
  closedWeeks                  WeekClosure[]
  telegramLinkCodes            TelegramLinkCode[]
  notifications                Notification[]
  createdAt                    DateTime              @default(now())
}

model LoginAttempt {
  login          String    @id
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

model PlatformAccount {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("PlatformAccountOwner", fields: [userId], references: [id])
  addedById   String?
  addedBy     User?         @relation("PlatformAccountAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  approvedAt  DateTime?
  platform    Platform
  url         String
  status      AccountStatus @default(PENDING)
  submissions Submission[]

  @@unique([platform, url])
  @@index([addedById])
}

model Submission {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id])
  accountId    String
  account      PlatformAccount       @relation(fields: [accountId], references: [id])
  videoUrl     String                @unique
  publishedAt  DateTime
  views        Int                   @default(0)
  amountCents  Int                   @default(0)
  weekStart    DateTime
  status       SubmissionStatus      @default(PENDING)
  rejectReason String?
  reviewedAt   DateTime?
  messages     Message[]
  readStates   SubmissionReadState[]
  createdAt    DateTime              @default(now())

  @@index([status, weekStart])
  @@index([userId, weekStart])
}

model Message {
  id           String              @id @default(cuid())
  submissionId String
  submission   Submission          @relation(fields: [submissionId], references: [id])
  authorId     String
  author       User                @relation(fields: [authorId], references: [id])
  text         String
  attachments  MessageAttachment[]
  createdAt    DateTime            @default(now())

  @@index([authorId, createdAt])
  @@index([submissionId, createdAt, id])
}

model MessageAttachment {
  id         String   @id @default(cuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Restrict)
  storageKey String   @unique
  mime       String
  sizeBytes  Int
  width      Int
  height     Int
  createdAt  DateTime @default(now())

  @@index([messageId, createdAt, id])
  @@index([createdAt])
}

model SubmissionReadState {
  userId       String
  submissionId String
  lastReadAt   DateTime
  user         User       @relation(fields: [userId], references: [id])
  submission   Submission @relation(fields: [submissionId], references: [id])

  @@id([userId, submissionId])
}

model LedgerEntry {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  type         LedgerType
  amountCents  Int
  submissionId String?    @unique
  weekStart    DateTime?
  payoutId     String?
  payout       Payout?    @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  note         String?
  createdAt    DateTime   @default(now())

  @@index([userId, createdAt])
}

model Payout {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation("PayoutOwner", fields: [userId], references: [id])
  amountCents   Int
  method        PayoutMethod
  destination   String
  status        PayoutStatus  @default(REQUESTED)
  createdAt     DateTime      @default(now())
  processedAt   DateTime?
  processedById String?
  processedBy   User?         @relation("PayoutProcessor", fields: [processedById], references: [id], onDelete: Restrict)
  txRef         String?
  rejectReason  String?
  ledgerEntries LedgerEntry[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model WeekClosure {
  id         String   @id @default(cuid())
  weekStart  DateTime @unique
  closedAt   DateTime @default(now())
  closedById String
  closedBy   User     @relation(fields: [closedById], references: [id])
}

model WeekResult {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  weekStart     DateTime
  weekCents     Int
  carryInCents  Int
  payableCents  Int
  carryOutCents Int
  expiredCents  Int
  createdAt     DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([weekStart])
}

model TelegramLinkCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, createdAt])
  @@index([expiresAt, usedAt])
}

model TelegramStartAttempt {
  chatHash        String   @id
  failedAttempts  Int      @default(0)
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt
}

model TelegramWorkerLease {
  id         String   @id
  workerId   String
  leaseUntil DateTime
  updatedAt  DateTime @updatedAt
}

model TelegramWorkerState {
  id         String @id
  nextOffset BigInt @default(0)
}

model Notification {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            NotificationKind
  text            String
  lastErrorCode   String?
  status          NotificationStatus @default(PENDING)
  attempts        Int                @default(0)
  nextAttemptAt   DateTime           @default(now())
  createdAt       DateTime           @default(now())
  sentAt          DateTime?
  dedupeKey       String?            @unique
  leaseUntil      DateTime?
  recipientChatId String?

  @@index([status, nextAttemptAt, createdAt])
  @@index([userId, kind, createdAt])
}
